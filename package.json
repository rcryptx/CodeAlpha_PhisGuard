{
  "name": "codealpha-phisguard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "test": "vitest --run && npm run test:server",
    "test:server": "node --experimental-strip-types --test server/zynxService.node.test.ts",
    "dev:server": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env .server-dist/index.js",
    "start:server": "node --env-file-if-exists=.env .server-dist/index.js",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
